<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<!-- Home SOC Lab - Caso 2: cierra el punto ciego de la regla 92057 con la abreviatura -enc -->
<group name="local,sysmon,powershell,">
  <rule id="100100" level="12">
    <if_sid>92027</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s[-/](e|ec|en|enc|enco|encod|encode|encoded|encodedc|encodedco|encodedcom|encodedcomm|encodedcomma|encodedcomman|encodedcommand)\s</field>
    <description>PowerShell spawned a PowerShell process with an encoded command (abbreviation not covered by rule 92057)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>
</group>

<!-- Home SOC Lab - Caso 3: tareas programadas sospechosas y borrado de tareas -->
<group name="local,windows,scheduled_task,">
  <rule id="100110" level="10">
    <if_sid>60228</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)Command(?:\x26gt;|\x3e)(?:[^\x26\x3c]*\\+(?:Users\\+Public|AppData|Temp|ProgramData)\\+|(?:[^\x26\x3c]*\\+)?(?:powershell|pwsh|cmd|mshta|rundll32|regsvr32|wscript|cscript)(?:\.exe)?(?:\x26lt;|\x3c))</field>
    <description>Scheduled task created with a suspicious action (LOLBin or user-writable path): $(win.eventdata.taskName)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <rule id="100111" level="5">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4699$</field>
    <description>A scheduled task was deleted: $(win.eventdata.taskName)</description>
    <mitre>
      <id>T1070</id>
    </mitre>
  </rule>
</group>

<!-- Home SOC Lab - Caso 4: valores añadidos a claves Run (persistencia) -->
<group name="local,sysmon,autostart,">
  <rule id="100120" level="7">
    <if_sid>92300</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+CurrentVersion\\+Run(?:Once|OnceEx|Services|ServicesOnce)?\\+[^\\]+$</field>
    <description>Value set in a Run registry key (autostart on logon): $(win.eventdata.targetObject)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <rule id="100121" level="12">
    <if_sid>100120</if_sid>
    <field name="win.eventdata.details" type="pcre2">(?i)(?:\\+(?:Users\\+Public|AppData|Temp|ProgramData)\\+|(?:^|\\+|\s|")(?:powershell|pwsh|cmd|mshta|rundll32|regsvr32|wscript|cscript)(?:\.exe)?(?:\s|"|$))</field>
    <description>Run registry key points to a LOLBin or user-writable path: $(win.eventdata.details)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>
</group>

<!-- Home SOC Lab - Caso 5: descargas con BITS y conexiones de PowerShell a Internet -->
<group name="local,sysmon,network,">
  <rule id="100130" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\bitsadmin\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/(transfer|addfile|download|setnotifycmdline)\b</field>
    <description>bitsadmin used to create a BITS transfer job (possible file download): $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1197</id>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100131" level="6">
    <if_sid>92101</if_sid>
    <field name="win.eventdata.destinationIp" type="pcre2">^(?!(?:10\.|127\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|169\.254\.|::1$|(?i:fe80:|f[cd][0-9a-f]{2}:)))</field>
    <description>PowerShell opened a TCP connection to a public IP address: $(win.eventdata.destinationIp):$(win.eventdata.destinationPort)</description>
    <mitre>
      <id>T1071.001</id>
      <id>T1105</id>
    </mitre>
  </rule>
</group>
